# Copy this file to .env.local and fill in the values from your SEPARATE
# Inner Compass Supabase project (Project Settings -> API).
#
# NEVER commit .env.local. NEVER put the service_role key in any NEXT_PUBLIC_* var.

# Safe to expose to the browser (publishable / anon key):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used only in trusted server code (e.g. admin/seed scripts).
# Do NOT prefix with NEXT_PUBLIC_. Keep out of the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# The canonical site URL, used for auth redirects (e.g. password reset).
# Local: http://localhost:3000  | Production: your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
